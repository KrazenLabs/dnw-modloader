<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>DnWModLoader</AssemblyName>
    <RootNamespace>DnWModLoader</RootNamespace>
    <OutputType>Library</OutputType>
    <Description>Mod loader runtime for Drag'n Wash (Unity 6, Mono).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- HarmonyX bundled with loader (Harmony 2 API on MonoMod.RuntimeDetour) -->
    <PackageReference Include="HarmonyX" Version="2.16.1" />
    <!-- Mono.Cecil is used by the preloader to patch game assembly and inspect mods before loading -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx 5 plugin API -->
    <ProjectReference Include="..\BepInEx.Compat\BepInEx.Compat.csproj" />
    <!-- MelonLoader mod API -->
    <ProjectReference Include="..\MelonLoader.Compat\MelonLoader.Compat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game / engine assemblies, never copy these next to the loader -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedDir)UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(GameManagedDir)UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameManagedDir)Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
