<Project TreatAsLocalProperty="GameDir">

  <PropertyGroup>
    <DnwLoaderVersion>1.6.1</DnwLoaderVersion>
    <!-- Game folder: -p:GameDir=..., DNW_GAME_DIR, the parent of this folder, Steam's own install folder (registry), or the default Steam location. build.ps1 also searches every Steam library. -->
    <GameDir Condition="'$(GameDir)' == '' And '$(DNW_GAME_DIR)' != ''">$(DNW_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == '' And Exists('$(MSBuildThisFileDirectory)../DragNWash.exe')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../'))</GameDir>
    <SteamPath Condition="'$(GameDir)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_CURRENT_USER\Software\Valve\Steam', 'SteamPath', '', RegistryView.Registry64, RegistryView.Registry32))</SteamPath>
    <SteamGameDir Condition="'$(SteamPath)' != ''">$(SteamPath)/steamapps/common/Drag'n Wash/</SteamGameDir>
    <GameDir Condition="'$(GameDir)' == '' And '$(SteamGameDir)' != '' And Exists('$(SteamGameDir)DragNWash.exe')">$(SteamGameDir)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Drag'n Wash\</GameDir>
    <GameDir Condition="!HasTrailingSlash('$(GameDir)')">$(GameDir)\</GameDir>
    <GameManagedDir>$(GameDir)DragNWash_Data\Managed\</GameManagedDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>$(DnwLoaderVersion)</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>$(DnwLoaderVersion).0</FileVersion>
    <InformationalVersion>$(DnwLoaderVersion)</InformationalVersion>
    <Product>DnW Mod Loader</Product>
    <Company>DnW Mod Loader</Company>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
</Project>
