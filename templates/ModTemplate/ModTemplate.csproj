<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="GameDir">

  <!--
    Starter project for a Drag'n Wash mod.
    1. Copy this folder anywhere, rename the .csproj / AssemblyName / namespace.
    2. Make sure the DnW Mod Loader is installed in the game (its DLLs live in <game>\DnWModLoader\).
    3. `dotnet build` - the DLL and mod.json are copied into <game>/Mods/<AssemblyName>/ automatically.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MyMod</AssemblyName>
    <RootNamespace>MyMod</RootNamespace>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>portable</DebugType>
    <!-- Copy the build output into the game's Mods folder after each build. -->
    <DeployToGame>true</DeployToGame>
  </PropertyGroup>

  <!-- Game folder: -p:GameDir=..., DNW_GAME_DIR, Steam's own install folder (registry), or the default Steam location. -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' And '$(DNW_GAME_DIR)' != ''">$(DNW_GAME_DIR)</GameDir>
    <SteamPath Condition="'$(GameDir)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_CURRENT_USER\Software\Valve\Steam', 'SteamPath', '', RegistryView.Registry64, RegistryView.Registry32))</SteamPath>
    <SteamGameDir Condition="'$(SteamPath)' != ''">$(SteamPath)/steamapps/common/Drag'n Wash/</SteamGameDir>
    <GameDir Condition="'$(GameDir)' == '' And '$(SteamGameDir)' != '' And Exists('$(SteamGameDir)DragNWash.exe')">$(SteamGameDir)</GameDir>
    <SteamLibraryFile Condition="'$(GameDir)' == '' And '$(SteamPath)' != ''">$(SteamPath)/steamapps/libraryfolders.vdf</SteamLibraryFile>
    <SteamLibraries Condition="'$(SteamLibraryFile)' != '' And Exists('$(SteamLibraryFile)')">$([System.Text.RegularExpressions.Regex]::Unescape($([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(SteamLibraryFile)')), '[\s\S]*?"path"\s+"([^"]*)"|[\s\S]+$', '$1|'))))</SteamLibraries>
    <SteamLibraryGameDirs>$(SteamLibraries.Replace('|', '\steamapps\common\Drag%27n Wash\|'))||||||||</SteamLibraryGameDirs>
    <GameDir Condition="'$(GameDir)' == '' And Exists('$(SteamLibraryGameDirs.Split(|).GetValue(0))DragNWash.exe')">$(SteamLibraryGameDirs.Split(|).GetValue(0))</GameDir>
    <GameDir Condition="'$(GameDir)' == '' And Exists('$(SteamLibraryGameDirs.Split(|).GetValue(1))DragNWash.exe')">$(SteamLibraryGameDirs.Split(|).GetValue(1))</GameDir>
    <GameDir Condition="'$(GameDir)' == '' And Exists('$(SteamLibraryGameDirs.Split(|).GetValue(2))DragNWash.exe')">$(SteamLibraryGameDirs.Split(|).GetValue(2))</GameDir>
    <GameDir Condition="'$(GameDir)' == '' And Exists('$(SteamLibraryGameDirs.Split(|).GetValue(3))DragNWash.exe')">$(SteamLibraryGameDirs.Split(|).GetValue(3))</GameDir>
    <GameDir Condition="'$(GameDir)' == '' And Exists('$(SteamLibraryGameDirs.Split(|).GetValue(4))DragNWash.exe')">$(SteamLibraryGameDirs.Split(|).GetValue(4))</GameDir>
    <GameDir Condition="'$(GameDir)' == '' And Exists('$(SteamLibraryGameDirs.Split(|).GetValue(5))DragNWash.exe')">$(SteamLibraryGameDirs.Split(|).GetValue(5))</GameDir>
    <GameDir Condition="'$(GameDir)' == '' And Exists('$(SteamLibraryGameDirs.Split(|).GetValue(6))DragNWash.exe')">$(SteamLibraryGameDirs.Split(|).GetValue(6))</GameDir>
    <GameDir Condition="'$(GameDir)' == '' And Exists('$(SteamLibraryGameDirs.Split(|).GetValue(7))DragNWash.exe')">$(SteamLibraryGameDirs.Split(|).GetValue(7))</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Drag'n Wash\</GameDir>
    <GameDir Condition="!HasTrailingSlash('$(GameDir)')">$(GameDir)\</GameDir>
    <GameManagedDir>$(GameDir)DragNWash_Data\Managed\</GameManagedDir>
    <GameLoaderDir>$(GameDir)DnWModLoader\</GameLoaderDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Loader + Harmony from the installed package. -->
    <Reference Include="DnWModLoader">
      <HintPath>$(GameLoaderDir)DnWModLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameLoaderDir)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Only needed for [HarmonyILManipulator] patches (MonoMod.Cil.ILContext / ILCursor). -->
    <!--
    <Reference Include="MonoMod.Utils">
      <HintPath>$(GameLoaderDir)MonoMod.Utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(GameLoaderDir)Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
    -->
    <!-- Game code. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Engine modules; add more (UnityEngine.UI, Unity.TextMeshPro, Unity.InputSystem, ...) as needed. -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedDir)UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameManagedDir)UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true' And Exists('$(GameDir)DragNWash.exe')">
    <ItemGroup>
      <_DeployFiles Include="$(OutDir)$(AssemblyName).dll;$(OutDir)$(AssemblyName).pdb;$(OutDir)mod.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployFiles)" DestinationFolder="$(GameDir)Mods\$(AssemblyName)\" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
    <Message Importance="high" Text="Deployed $(AssemblyName) to $(GameDir)Mods\$(AssemblyName)\" />
  </Target>

</Project>
